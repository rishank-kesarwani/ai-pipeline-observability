# ==============================================================================
# AI Pipeline Observability & Recovery - Environment Configuration
# ==============================================================================

# Application Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
PUBLIC_ACCESS_ENABLED=true

# Database (MongoDB)
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/ai_pipeline_observability?retryWrites=true&w=majority
DB_USE_MEMORY_FALLBACK=true

# Redis & Queues
REDIS_URL=redis://default:password@redis-12345.c10.us-east-1-2.ec2.cloud.redislabs.com:12345
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USE_MEMORY_FALLBACK=true

# Authentication & JWT Secrets (Min 32 characters)
JWT_ACCESS_SECRET=your-secure-jwt-access-secret-min-32-chars-in-production
JWT_REFRESH_SECRET=your-secure-jwt-refresh-secret-min-32-chars-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Ingestion Service-to-Service API Key
SERVICE_API_KEY=your-pipeline-ingestion-api-key-placeholder

# Rate Limiting & Throttler
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=60

# Data Retention
TRACE_RETENTION_DAYS=30
MAX_PAYLOAD_BYTES=1048576

# Shared AI Platform Integration (Diagnosis & Reasoning Gateway)
AI_PLATFORM_BASE_URL=https://ai-platform.rishankkesharwani.com
AI_PLATFORM_OBSERVABILITY_API_KEY=your-ai-platform-service-key-placeholder
AI_PLATFORM_TIMEOUT_MS=30000

# Notification Service Integration (Alerts & Incident Notifications)
NOTIFICATION_SERVICE_BASE_URL=https://notifications.rishankkesharwani.com
NOTIFICATION_OBSERVABILITY_API_KEY=your-notification-service-key-placeholder
NOTIFICATION_TIMEOUT_MS=10000
ALERTS_RECIPIENT_EMAIL=alerts@pipeline-observability.local

# AI Model Regression Detection Integration (Benchmarking)
MODEL_REGRESSION_BASE_URL=https://model-regression.rishankkesharwani.com
MODEL_REGRESSION_API_KEY=your-model-regression-service-key-placeholder
MODEL_REGRESSION_TIMEOUT_MS=15000

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
